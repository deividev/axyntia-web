---
import Wordmark from './Wordmark.astro';

interface Props {
  anchorBase?: '' | '/';
}
const { anchorBase = '' } = Astro.props;
const links = [
  { href: 'servicios', label: 'Servicios' },
  { href: 'como-trabajamos', label: 'Cómo trabajamos' },
  { href: 'por-que', label: 'Por qué nosotros' },
  { href: 'contacto', label: 'Contacto' },
];
---

<header class="border-border bg-surface fixed inset-x-0 top-0 z-50 border-b">
  <div class="max-w-content relative mx-auto flex items-center gap-4 px-4 py-3 md:px-6 lg:px-8">
    <a href="/" aria-label="Axyntia, inicio" class="order-1 inline-flex min-h-11 items-center">
      <Wordmark />
    </a>
    {/* El DOM no cambia (orden de foco: logotipo, botón, nav, «Hablemos»); solo las clases order-*
       dejan «Hablemos» a la derecha junto al botón entre 640 y 1023 px (issue #8). */}
    <button
      type="button"
      class="menu-btn border-border-control text-text order-4 ml-auto h-11 min-w-11 items-center justify-center rounded-md border px-3 sm:ml-0"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Menú"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <nav id="site-nav" aria-label="Principal" class="nav-links order-2 lg:ml-auto">
      {links.map((l) => (
        <a
          href={`${anchorBase}#${l.href}`}
          class="text-text-muted hover:text-text inline-flex min-h-11 items-center"
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="order-3 ml-auto hidden items-center sm:flex lg:ml-0">
      <a href={`${anchorBase}#contacto`} class="btn btn-primary">
        Hablemos
      </a>
    </div>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>
