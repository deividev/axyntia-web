---
import Wordmark from './Wordmark.astro';

interface Props {
  anchorBase?: '' | '/';
}
const { anchorBase = '' } = Astro.props;
const links = [
  { href: 'servicios', label: 'Servicios' },
  { href: 'como-trabajamos', label: 'Cómo trabajamos' },
  { href: 'por-que', label: 'Por qué nosotros' },
  { href: 'contacto', label: 'Contacto' },
];
---

<header class="border-border bg-bg/90 fixed inset-x-0 top-0 z-50 border-b backdrop-blur">
  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" aria-label="Axyntia, inicio">
      <Wordmark />
    </a>
    <nav id="site-nav" aria-label="Principal" class="nav-links lg:ml-auto">
      {links.map((l) => (
        <a href={`${anchorBase}#${l.href}`} class="text-text-muted hover:text-text py-2">
          {l.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={`${anchorBase}#contacto`} class="btn btn-primary hidden sm:inline-flex">
        Hablemos
      </a>
      <button
        type="button"
        class="menu-btn border-border-control text-text h-11 min-w-11 items-center justify-center rounded-md border px-3"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Menú"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>
