---
import Wordmark from './Wordmark.astro';

interface Props {
  anchorBase?: '' | '/';
}
const { anchorBase = '' } = Astro.props;
const links = [
  { href: 'servicios', label: 'Servicios' },
  { href: 'como-trabajamos', label: 'Cómo trabajamos' },
  { href: 'por-que', label: 'Por qué nosotros' },
  { href: 'contacto', label: 'Contacto' },
];
---

<header class="border-border bg-surface fixed inset-x-0 top-0 z-50 border-b">
  <div class="max-w-content relative mx-auto flex items-center gap-3 px-6 py-4">
    <a href="/" aria-label="Axyntia, inicio">
      <Wordmark />
    </a>
    {/* El botón va en el DOM justo antes del nav (orden de foco, WCAG 2.4.3); order-last lo deja a la derecha. */}
    <button
      type="button"
      class="menu-btn border-border-control text-text order-last h-11 min-w-11 items-center justify-center rounded-sm border px-3"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Menú"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <nav id="site-nav" aria-label="Principal" class="nav-links lg:ml-auto">
      {links.map((l) => (
        <a href={`${anchorBase}#${l.href}`} class="text-text-muted hover:text-text py-2">
          {l.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center lg:ml-0">
      <a href={`${anchorBase}#contacto`} class="btn btn-primary hidden sm:inline-flex">
        Hablemos
      </a>
    </div>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>
