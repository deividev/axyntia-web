---
import { site } from '../config/site';
import ContactForm from './ContactForm.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const waUrl = buildWhatsAppUrl(site.whatsappNumber, site.whatsappMessage);
---

<section id="contacto" data-reveal class="bg-surface py-20">
  <div class="mx-auto max-w-3xl px-6">
    <p class="text-primary font-mono text-sm">// Contacto</p>
    <h2 class="mt-3 text-3xl font-bold md:text-4xl">Hablemos de tu proyecto</h2>
    <p class="text-text-muted mt-4">
      Cuéntanos tu idea. Te respondemos en 24 h laborables con una propuesta sin compromiso.
    </p>
    <noscript>
      <p class="border-border-control mt-6 rounded-md border p-4">
        Para enviar el formulario hace falta JavaScript. Mientras tanto, escríbenos a
        <a class="text-primary underline" href={`mailto:${site.contactEmail}`}
          >{site.contactEmail}</a
        >
        o por <a class="text-primary underline" href={waUrl}>WhatsApp</a>.
      </p>
    </noscript>
    <ContactForm />
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      <WhatsAppLink label="Escríbenos por WhatsApp" />
      <a class="text-primary underline" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </div>
  </div>
</section>
