---
import { site } from '../config/site';
import ContactForm from './ContactForm.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section id="contacto" class="border-border bg-surface border-y py-16 md:py-24">
  <div class="max-w-content mx-auto grid gap-10 px-4 md:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
    <div class="lg:col-span-5">
      <h2 class="text-heading-sm md:text-heading font-bold">Hablemos de tu proyecto</h2>
      <p class="text-text-muted mt-4 max-w-prose">
        Cuéntanos tu idea. Te respondemos en 24 h laborables con una propuesta sin compromiso.
      </p>
      <noscript>
        <p class="border-border-control mt-6 rounded-sm border p-4">
          Para enviar el formulario hace falta JavaScript. Mientras tanto, escríbenos a
          <a class="link" href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          o por <WhatsAppLink label="WhatsApp" variant="inline" />.
        </p>
      </noscript>
      <div class="mt-8 flex flex-col items-start gap-4">
        <WhatsAppLink label="Escríbenos por WhatsApp" />
        <a class="link inline-flex min-h-11 items-center" href={`mailto:${site.contactEmail}`}>
          {site.contactEmail}
        </a>
      </div>
    </div>
    <div class="lg:col-span-7">
      <ContactForm />
    </div>
  </div>
</section>
