---
import WhatsAppLink from './WhatsAppLink.astro';
---

<section data-hero class="hero-bg relative isolate overflow-hidden pt-32 pb-20 lg:pt-44 lg:pb-32">
  <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <canvas
    data-hero-canvas
    aria-hidden="true"
    class="absolute inset-y-0 right-0 -z-10 h-full w-full opacity-60 lg:w-1/2"></canvas>
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-primary font-mono text-sm">// Software a medida e IA</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-bold md:text-6xl">
      Software a medida e IA que trabajan para tu empresa
    </h1>
    <p class="text-text-muted mt-6 max-w-2xl text-lg">
      Diseñamos CRM visuales en 3D, agentes de IA y automatizaciones que ahorran horas y costes a
      pymes como la tuya.
    </p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <a href="#contacto" class="btn btn-primary">Solicita una propuesta</a>
      <WhatsAppLink label="Escríbenos por WhatsApp" />
    </div>
  </div>
  <script>
    import '../scripts/hero-canvas';
  </script>
</section>
