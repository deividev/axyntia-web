---
import Wordmark from './Wordmark.astro';
import { site } from '../config/site';

interface Props {
  anchorBase?: '' | '/';
}
const { anchorBase = '' } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { href: 'servicios', label: 'Servicios' },
  { href: 'como-trabajamos', label: 'Cómo trabajamos' },
  { href: 'por-que', label: 'Por qué nosotros' },
  { href: 'contacto', label: 'Contacto' },
];
---

<footer class="border-border bg-surface border-t">
  <div class="max-w-content mx-auto flex flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between">
    <Wordmark />
    <nav aria-label="Secciones" class="flex flex-wrap gap-4">
      {links.map((l) => (
        <a href={`${anchorBase}#${l.href}`} class="text-text-muted hover:text-text py-2">
          {l.label}
        </a>
      ))}
    </nav>
    <nav aria-label="Legal" class="flex flex-wrap gap-4">
      <a href="/aviso-legal" class="text-text-muted hover:text-text py-2">
        Aviso legal
      </a>
      <a href="/privacidad" class="text-text-muted hover:text-text py-2">
        Política de privacidad
      </a>
    </nav>
  </div>
  <p class="text-text-muted max-w-content mx-auto px-6 pb-8 text-sm">
    © {year} {site.companyName}
  </p>
</footer>
