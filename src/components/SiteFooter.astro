---
import Wordmark from './Wordmark.astro';
import { site } from '../config/site';

interface Props {
  anchorBase?: '' | '/';
}
const { anchorBase = '' } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { href: 'servicios', label: 'Servicios' },
  { href: 'como-trabajamos', label: 'Cómo trabajamos' },
  { href: 'por-que', label: 'Por qué nosotros' },
  { href: 'contacto', label: 'Contacto' },
];
---

<footer class="border-border bg-surface border-t">
  <div class="max-w-content mx-auto flex flex-col gap-6 px-4 py-10 md:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <Wordmark />
    <nav aria-label="Secciones" class="flex flex-wrap gap-x-6">
      {links.map((l) => (
        <a
          href={`${anchorBase}#${l.href}`}
          class="text-text-muted hover:text-text inline-flex min-h-11 items-center"
        >
          {l.label}
        </a>
      ))}
    </nav>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-6">
      <a
        href="/aviso-legal"
        class="text-text-muted hover:text-text inline-flex min-h-11 items-center"
      >
        Aviso legal
      </a>
      <a
        href="/privacidad"
        class="text-text-muted hover:text-text inline-flex min-h-11 items-center"
      >
        Política de privacidad
      </a>
    </nav>
  </div>
  <p class="text-text-muted max-w-content text-label mx-auto px-4 pb-8 md:px-6 lg:px-8">
    © {year} {site.companyName}
  </p>
</footer>
