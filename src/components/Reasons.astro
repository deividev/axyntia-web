---
const reasons = [
  {
    title: 'A medida y sin plantillas',
    text: 'Cada solución se diseña para tu forma de trabajar, no para encajar en un molde.',
  },
  {
    title: 'IA aplicada a resultados medibles',
    text: 'Usamos la IA donde ahorra tiempo o dinero y te mostramos el efecto real.',
  },
  {
    title: 'Comunicación directa con quien desarrolla',
    text: 'Hablas con las personas que construyen tu proyecto, sin intermediarios.',
  },
  {
    title: 'Código y datos tuyos',
    text: 'Lo que desarrollamos y la información de tu empresa te pertenecen siempre.',
  },
];
---

<section id="por-que" data-reveal class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-primary font-mono text-sm">// Por qué nosotros</p>
    <h2 class="mt-3 text-3xl font-bold md:text-4xl">Razones para trabajar con Axyntia</h2>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {reasons.map((r) => (
        <li class="card p-6" data-reason data-card>
          <h3 class="text-xl font-bold">{r.title}</h3>
          <p class="text-text-muted mt-2">{r.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
