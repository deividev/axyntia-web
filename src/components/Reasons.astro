---
// No va en el albarán: las razones no tienen «para quién» ni «qué resuelve» (justificado en el informe).
const reasons = [
  {
    title: 'A medida y sin plantillas',
    text: 'Cada solución se diseña para tu forma de trabajar, no para encajar en un molde.',
  },
  {
    title: 'IA aplicada a resultados medibles',
    text: 'Usamos la IA donde ahorra tiempo o dinero y te mostramos el efecto real.',
  },
  {
    title: 'Comunicación directa con quien desarrolla',
    text: 'Hablas con las personas que construyen tu proyecto, sin intermediarios.',
  },
  {
    title: 'Código y datos tuyos',
    text: 'Lo que desarrollamos y la información de tu empresa te pertenecen siempre.',
  },
];
---

<section id="por-que" class="py-16 md:py-24">
  <div class="max-w-content mx-auto px-4 md:px-6 lg:px-8">
    <h2 class="text-heading-sm md:text-heading max-w-prose font-bold">
      Razones para trabajar con Axyntia
    </h2>
    <ul class="mt-10 grid gap-x-12 md:mt-12 md:grid-cols-2">
      {reasons.map((r) => (
        <li class="border-border border-t py-6" data-reason>
          <h3 class="text-subheading font-semibold">{r.title}</h3>
          <p class="text-text-muted mt-2 max-w-prose">{r.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
