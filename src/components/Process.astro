---
import Ledger from './Ledger.astro';

const steps = [
  {
    title: 'Descubrimiento',
    text: 'Hablamos contigo, entendemos tu negocio y detectamos dónde se pierde tiempo y dinero.',
  },
  {
    title: 'Diseño y prototipo',
    text: 'Te enseñamos cómo quedará antes de construirlo, para que decidas con algo real delante.',
  },
  {
    title: 'Desarrollo por iteraciones',
    text: 'Entregamos por partes y ajustamos con tu opinión en cada entrega.',
  },
  {
    title: 'Lanzamiento y mejora continua',
    text: 'Ponemos todo en marcha, formamos a tu equipo y seguimos mejorando con el uso real.',
  },
];

const columns = [
  { key: 'step', header: 'Paso' },
  { key: 'text', header: 'Qué hacemos' },
] as const;
const rows = steps.map((s, i) => ({ n: i + 1, cells: { step: s.title, text: s.text } }));
---

<section id="como-trabajamos" class="border-border bg-surface border-y py-16 md:py-24">
  <div class="max-w-content mx-auto px-4 md:px-6 lg:px-8">
    <h2 class="text-heading-sm md:text-heading max-w-prose font-bold">
      Un proceso claro, paso a paso
    </h2>
    <div class="mt-10 md:mt-12">
      <Ledger label="Cómo trabajamos" variant="process" columns={columns} rows={rows} />
    </div>
  </div>
</section>
