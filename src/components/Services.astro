---
import { SERVICES, type ServiceId } from '../lib/services';
import Ledger from './Ledger.astro';

// «Para quién» no existía en los datos: frases cortas sacadas de la descripción de cada servicio
// (cambio de contenido justificado en el informe del trabajo; pendiente de validar por David).
const audience: Record<ServiceId, string> = {
  'crm-3d': 'Equipos que llevan clientes, ventas y proyectos en hojas de cálculo',
  'software-a-medida': 'Empresas cuya forma de trabajar no cabe en un programa genérico',
  'agentes-ia': 'Negocios que atienden muchas consultas o preparan informes a mano',
  automatizaciones: 'Equipos que pasan datos a mano de un programa a otro',
};

const columns = [
  { key: 'concept', header: 'Concepto' },
  { key: 'audience', header: 'Para quién', label: 'Para quién' },
  { key: 'resolves', header: 'Qué resuelve', label: 'Qué resuelve' },
] as const;
const rows = SERVICES.map((s, i) => ({
  n: i + 1,
  cells: { concept: s.title, audience: audience[s.id], resolves: [s.description, ...s.benefits] },
}));
---

<section id="servicios" class="py-16 md:py-24">
  <div class="max-w-content mx-auto px-4 md:px-6 lg:px-8">
    <h2 class="text-heading-sm md:text-heading max-w-prose font-bold">
      Lo que hacemos por tu empresa
    </h2>
    <div class="mt-10 md:mt-12">
      <Ledger label="Servicios" variant="services" columns={columns} rows={rows} />
    </div>
  </div>
</section>
