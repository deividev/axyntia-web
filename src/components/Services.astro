---
import { SERVICES } from '../lib/services';
---

<section id="servicios" class="py-20">
  <div class="max-w-content mx-auto px-6">
    <h2 class="type-heading">Lo que hacemos por tu empresa</h2>
    <div
      aria-hidden="true"
      class="ledger-grid type-label text-text-muted mt-12 hidden pb-3 lg:grid"
    >
      <span>Nº</span>
      <span>Concepto</span>
      <span>Qué resuelve</span>
      <span>Qué consigues</span>
    </div>
    <ol class="mt-12 lg:mt-0">
      {SERVICES.map((s, i) => (
        <li data-service-row class="ledger-grid border-border gap-y-4 border-t py-8">
          <div class="flex min-w-0 items-baseline gap-4 lg:contents">
            <span data-line-number class="type-figure">
              <span class="sr-only">Línea </span>
              {i + 1}
            </span>
            <h3 class="type-subheading min-w-0 break-words">{s.title}</h3>
          </div>
          <div class="min-w-0 break-words">
            <p class="type-label text-text-muted lg:sr-only">Qué resuelve</p>
            <p class="text-text-muted mt-1 lg:mt-0">{s.description}</p>
          </div>
          <div class="min-w-0 break-words">
            <p class="type-label text-text-muted lg:sr-only">Qué consigues</p>
            <ul class="mt-1 space-y-2 lg:mt-0">
              {s.benefits.map((b) => (
                <li class="flex gap-2">
                  <span class="text-success" aria-hidden="true">
                    ✓
                  </span>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
