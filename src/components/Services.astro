---
import { SERVICES, type ServiceId } from '../lib/services';

const icons: Record<ServiceId, string> = {
  'crm-3d': 'M12 3 4 7.5v9L12 21l8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9',
  'software-a-medida': 'M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16',
  'agentes-ia': 'M9 3h6v3H9zM5 8h14v11H5zM9 13h.01M15 13h.01M9 16.5h6',
  automatizaciones: 'M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4',
};
---

<section id="servicios" data-reveal class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-primary font-mono text-sm">// Servicios</p>
    <h2 class="mt-3 text-3xl font-bold md:text-4xl">Lo que hacemos por tu empresa</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        SERVICES.map((s) => (
          <article class="card p-6" data-card>
            <svg
              viewBox="0 0 24 24"
              class="text-primary h-10 w-10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[s.id]} />
            </svg>
            <h3 class="mt-4 text-xl font-bold">{s.title}</h3>
            <p class="text-text-muted mt-3">{s.description}</p>
            <ul class="mt-4 space-y-2">
              {s.benefits.map((b) => (
                <li class="text-text flex gap-2">
                  <span class="text-success" aria-hidden="true">
                    ✓
                  </span>
                  {b}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
