---
import '../styles/global.css';
import { site } from '../config/site';
import { absoluteUrl, buildOrganizationJsonLd, serializeJsonLd } from '../lib/seo';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  anchorBase?: '' | '/';
  jsonLd?: boolean;
}
const { title, description, path, anchorBase = '', jsonLd = false } = Astro.props;
const canonical = absoluteUrl(site.siteUrl, path);
const ogImage = absoluteUrl(site.siteUrl, '/og-image.png');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.companyName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(buildOrganizationJsonLd(site))}
      />
    )}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#contenido" class="skip-link">
      Saltar al contenido
    </a>
    <SiteHeader anchorBase={anchorBase} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter anchorBase={anchorBase} />
  </body>
</html>
